{
  "name": "mullwise-workspace",
  "private": true,
  "description": "Mullwise: your random thought organizer (workspace root).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome ci .",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@fast-check/vitest": "^0.5.0",
    "@types/node": "^24.13.6",
    "fast-check": "^4.10.2",
    "lefthook": "^2.1.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
